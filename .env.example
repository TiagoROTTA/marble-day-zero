# LLM
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
# Cost lever: high-volume nodes read LLM_MODEL_CHEAP.
# Set to claude-haiku-4-5 to downgrade bulk work without touching code.
LLM_MODEL_CHEAP=claude-opus-5
LLM_MAX_TOKENS=16000

# Agent behavior
MAX_RETRIES=3

# Checkpointer
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite

# Slack (leave empty for degraded "print" mode)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVAL_CHANNEL=

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
PUBLIC_TUNNEL_URL=
