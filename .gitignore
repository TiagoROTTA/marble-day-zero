.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets & local config
# .env.example is deliberately NOT ignored: it is the only thing telling a
# stranger which variables the project needs. Every real secret lives in .env
# or a hand-made backup of it, and both must stay out of history.
.env
.env.*
!.env.example

# Runtime data
# The -shm and -wal sidecars are SQLite's write-ahead log, rewritten on every
# run: they carry no information the checkpoint database itself does not.
data/*.sqlite
data/*.sqlite-journal
data/*.sqlite-shm
data/*.sqlite-wal
data/*.db

# Loose documents that sit in the working directory but are not the project.
# The corpus PDFs live under data/restaurants/ and are unaffected.
/*.pdf

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
*.egg-info/

# Build plans: kept locally, deliberately not published.
plans/

# Local agent instructions, deliberately not published.
CLAUDE.md
exec_feature.md
